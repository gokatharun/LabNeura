/*
 * LabNeura educational standard-cell library.
 *
 * This file is synthetic and intended only for parser examples and tests.
 * The areas and timing values are illustrative, not characterized data for
 * any manufacturing process. Do not use for synthesis, timing signoff, or
 * physical design.
 */
library (labneura_educational_cells) {
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    capacitive_load_unit (1, pf);

    lu_table_template (delay_2d) {
        variable_1 : input_net_transition;
        variable_2 : total_output_net_capacitance;
        index_1 ("0.05, 0.20");
        index_2 ("0.01, 0.10");
    }

    cell (INV_X1) {
        area : 0.50;
        pin (A) {
            direction : input;
            capacitance : 0.002;
        }
        pin (Y) {
            direction : output;
            function : "!A";
            timing () {
                related_pin : "A";
                timing_type : combinational;
                timing_sense : negative_unate;
                cell_rise (delay_2d) {
                    values ("0.035, 0.060", "0.055, 0.080");
                }
                cell_fall (delay_2d) {
                    values ("0.030, 0.052", "0.048, 0.072");
                }
                rise_transition (delay_2d) {
                    values ("0.020, 0.035", "0.030, 0.050");
                }
                fall_transition (delay_2d) {
                    values ("0.018, 0.032", "0.028, 0.046");
                }
            }
        }
    }

    cell (BUF_X1) {
        area : 0.40;
        pin (A) {
            direction : input;
            capacitance : 0.002;
        }
        pin (Y) {
            direction : output;
            function : "A";
        }
    }

    cell (TIELO_X1) {
        area : 0.10;
        pin (Y) {
            direction : output;
            function : "0";
        }
    }

    cell (TIEHI_X1) {
        area : 0.10;
        pin (Y) {
            direction : output;
            function : "1";
        }
    }

    cell (AND2_X1) {
        area : 0.90;
        pin (A) {
            direction : input;
            capacitance : 0.003;
        }
        pin (B) {
            direction : input;
            capacitance : 0.003;
        }
        pin (Y) {
            direction : output;
            function : "A & B";
            timing () {
                related_pin : "A";
                timing_type : combinational;
                timing_sense : positive_unate;
                cell_rise (delay_2d) {
                    values ("0.050, 0.082", "0.075, 0.110");
                }
                cell_fall (delay_2d) {
                    values ("0.042, 0.070", "0.065, 0.098");
                }
            }
            timing () {
                related_pin : "B";
                timing_type : combinational;
                timing_sense : positive_unate;
                cell_rise (delay_2d) {
                    values ("0.052, 0.085", "0.078, 0.114");
                }
                cell_fall (delay_2d) {
                    values ("0.044, 0.073", "0.068, 0.102");
                }
            }
        }
    }

    cell (XOR2_X1) {
        area : 1.20;
        pin (A) {
            direction : input;
            capacitance : 0.004;
        }
        pin (B) {
            direction : input;
            capacitance : 0.004;
        }
        pin (Y) {
            direction : output;
            function : "A ^ B";
        }
    }

    cell (OR2_X1) {
        area : 0.90;
        pin (A) {
            direction : input;
            capacitance : 0.003;
        }
        pin (B) {
            direction : input;
            capacitance : 0.003;
        }
        pin (Y) {
            direction : output;
            function : "A | B";
            timing () {
                related_pin : "A";
                timing_type : combinational;
                timing_sense : positive_unate;
                cell_rise (delay_2d) {
                    values ("0.046, 0.076", "0.070, 0.104");
                }
                cell_fall (delay_2d) {
                    values ("0.055, 0.090", "0.082, 0.122");
                }
            }
            timing () {
                related_pin : "B";
                timing_type : combinational;
                timing_sense : positive_unate;
                cell_rise (delay_2d) {
                    values ("0.048, 0.079", "0.073, 0.108");
                }
                cell_fall (delay_2d) {
                    values ("0.057, 0.093", "0.085, 0.126");
                }
            }
        }
    }

    cell (MUX2_X1) {
        area : 1.60;
        pin (A0) {
            direction : input;
            capacitance : 0.004;
        }
        pin (A1) {
            direction : input;
            capacitance : 0.004;
        }
        pin (S) {
            direction : input;
            capacitance : 0.005;
        }
        pin (Y) {
            direction : output;
            function : "(!S & A0) | (S & A1)";
            timing () {
                related_pin : "A0";
                timing_type : combinational;
                timing_sense : positive_unate;
                cell_rise (delay_2d) {
                    values ("0.075, 0.120", "0.108, 0.160");
                }
                cell_fall (delay_2d) {
                    values ("0.070, 0.112", "0.101, 0.151");
                }
            }
            timing () {
                related_pin : "A1";
                timing_type : combinational;
                timing_sense : positive_unate;
                cell_rise (delay_2d) {
                    values ("0.078, 0.124", "0.112, 0.166");
                }
                cell_fall (delay_2d) {
                    values ("0.073, 0.116", "0.105, 0.157");
                }
            }
            timing () {
                related_pin : "S";
                timing_type : combinational;
                timing_sense : non_unate;
                cell_rise (delay_2d) {
                    values ("0.090, 0.140", "0.128, 0.188");
                }
                cell_fall (delay_2d) {
                    values ("0.088, 0.136", "0.124, 0.182");
                }
            }

        }
    }

    cell (MUX4_X1) {
        area : 2.80;
        pin (A0) {
            direction : input;
            capacitance : 0.006;
        }
        pin (A1) {
            direction : input;
            capacitance : 0.006;
        }
        pin (A2) {
            direction : input;
            capacitance : 0.006;
        }
        pin (A3) {
            direction : input;
            capacitance : 0.006;
        }
        pin (S0) {
            direction : input;
            capacitance : 0.007;
        }
        pin (S1) {
            direction : input;
            capacitance : 0.007;
        }
        pin (Y) {
            direction : output;
            function : "(!S1 & !S0 & A0) | (!S1 & S0 & A1) | (S1 & !S0 & A2) | (S1 & S0 & A3)";
        }
    }
}
